# Run scripts/setup-local.sh to generate local credentials in ignored .env.
# Keep this file free of real credentials. PAPER cannot route exchange orders.
APP_ENV=development
TRADING_MODE=PAPER
LIVE_EXECUTION_ENABLED=false
SESSION_COOKIE_SECURE=false
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgresql+psycopg://tradebot:REPLACE_LOCALLY@127.0.0.1:5432/tradebot
REDIS_URL=redis://:REPLACE_LOCALLY@127.0.0.1:6379/0
POSTGRES_USER=tradebot
POSTGRES_DB=tradebot
POSTGRES_PASSWORD=REPLACE_LOCALLY
REDIS_PASSWORD=REPLACE_LOCALLY
BOOTSTRAP_USERNAME=operator
BOOTSTRAP_PASSWORD=REPLACE_LOCALLY
BACKEND_URL=http://127.0.0.1:8000
# USD paper accounting; INR is a separate configurable planning input.
# Optional demo credentials belong only in a local secret manager or ignored .env.
DELTA_DEMO_API_KEY=
DELTA_DEMO_API_SECRET=
DEMO_EXECUTION_AUTHORIZED=false
TELEGRAM_DELIVERY_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NEWS_ALLOWED_HOSTS=
# Vault CLI initializes these owner-only files; preserve the key for MFA recovery.
TRADEBOT_VAULT_KEY_FILE=.runtime/vault.key
TRADEBOT_VAULT_FILE=.runtime/credentials.vault
