# syntax=docker/dockerfile:1.7
FROM python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
COPY infrastructure/requirements.lock /app/infrastructure/requirements.lock
# A public CA bundle may be supplied by the managed cloud runtime. Verification remains enabled.
RUN --mount=type=secret,id=platform_ca,required=false \
    if [ -f /run/secrets/platform_ca ]; then export PIP_CERT=/run/secrets/platform_ca; fi; \
    pip install --no-cache-dir --require-hashes -r infrastructure/requirements.lock
COPY pyproject.toml /app/
COPY services /app/services
COPY packages /app/packages
RUN --mount=type=secret,id=platform_ca,required=false \
    if [ -f /run/secrets/platform_ca ]; then export PIP_CERT=/run/secrets/platform_ca; fi; \
    pip install --no-cache-dir --no-deps . && useradd --uid 10001 --create-home tradebot \
    && chmod -R a+rX /app/services /app/packages
USER tradebot
EXPOSE 8000
CMD ["uvicorn", "tradebot.app:app", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers"]
