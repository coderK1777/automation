      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "API p95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tradebot-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le,route) (rate(tradebot_http_request_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "{{symbol}} {{channel}} {{route}} {{environment}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Unobserved",
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "API errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tradebot-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(tradebot_http_requests_total{status=~\"5..\"}[5m]))",
